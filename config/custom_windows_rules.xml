<group name="windows,windows_security,privilege_escalation,persistence,defense_evasion,credential_access,">

  <!-- Windows Defender Exclusion Added -->
  <rule id="100301" level="10">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Microsoft-Windows-Windows Defender/Operational$</field>
    <field name="win.system.eventID">^5007$</field>
    <match>ExclusionPath|ExclusionProcess|ExclusionExtension</match>
    <description>Windows Defender AV exclusion list modified</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>defense_evasion,antivirus_tamper,</group>
  </rule>

  <!-- Suspicious PowerShell Download Cradle or Encoded Execution -->
  <rule id="100302" level="12">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Microsoft-Windows-PowerShell/Operational$</field>
    <field name="win.system.eventID">^4104$</field>
    <pcre2>(?i)(DownloadString|DownloadFile|IEX|Invoke-Expression|FromBase64String|-enc |-encodedcommand|Net\.WebClient|BitTransfer)</pcre2>
    <description>Suspicious PowerShell script block executed (Download Cradle / Obfuscation)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>powershell_execution,command_and_control,</group>
  </rule>

  <!-- Scheduled Task Created via Schtasks / Task Scheduler -->
  <rule id="100303" level="8">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4698$</field>
    <description>Scheduled task created (Potential Persistence)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,scheduled_task,</group>
  </rule>

  <!-- Local Group Enumeration / Sensitive Privilege Use (SeDebugPrivilege / SeTcbPrivilege) -->
  <rule id="100304" level="9">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4672$</field>
    <pcre2>(?i)(SeDebugPrivilege|SeTcbPrivilege|SeAssignPrimaryTokenPrivilege)</pcre2>
    <field name="win.eventdata.subjectUserName" negate="yes">^SYSTEM$|^LOCAL SERVICE$|^NETWORK SERVICE$</field>
    <description>Special privileges assigned to non-system logon session</description>
    <mitre>
      <id>T1078</id>
      <id>T1134</id>
    </mitre>
    <group>privilege_escalation,</group>
  </rule>

  <!-- LSASS Memory Access via Process Creation (ProcDump, Taskmgr, comsvcs.dll) -->
  <rule id="100305" level="13">
    <if_group>windows</if_group>
    <field name="win.system.channel">^Security$|^Microsoft-Windows-Sysmon/Operational$</field>
    <pcre2>(?i)(procdump(\.exe)?.*lsass|rundll32(\.exe)?.*comsvcs(\.dll)?.*(#24|MiniDump)|taskmgr(\.exe)?.*lsass|Out-Minidump)</pcre2>
    <description>Potential LSASS process memory dump attempt (OS Credential Dumping)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass_dump,</group>
  </rule>

  <!-- Windows Event Log Cleared (Security, System, PowerShell) -->
  <rule id="100306" level="11">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1102$|^104$</field>
    <description>Windows audit event log was cleared (Defense Evasion / Anti-Forensics)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,log_cleared,</group>
  </rule>

</group>